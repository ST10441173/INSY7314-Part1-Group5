{
	"info": {
		"name": "HustleHub+ Part 1 - Secure Foundations",
		"description": "Registration, login, and protected-route tests for the HustleHub+ Part 1 backend. Run with the 'HustleHub Local' environment, or set base_url manually.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Register - success",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
							"pm.test('Response contains user object without password', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.user).to.have.property('id');",
							"    pm.expect(json.user).to.not.have.property('password');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Passw0rd123\",\n  \"role\": \"Freelancer\"\n}"
				},
				"url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
			}
		},
		{
			"name": "Register - duplicate email",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 409', function () { pm.response.to.have.status(409); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Passw0rd123\",\n  \"role\": \"Freelancer\"\n}"
				},
				"url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
			}
		},
		{
			"name": "Register - missing/invalid fields",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
							"pm.test('Response lists validation details', function () {",
							"    pm.expect(pm.response.json().details.length).to.be.greaterThan(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"role\": \"Wizard\"\n}"
				},
				"url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
			}
		},
		{
			"name": "Login - success",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
							"pm.test('Response contains a JWT', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.token).to.be.a('string');",
							"    pm.collectionVariables.set('jwt_token', json.token);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"Passw0rd123\"\n}"
				},
				"url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
			}
		},
		{
			"name": "Login - wrong password",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"WrongPassword1\"\n}"
				},
				"url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
			}
		},
		{
			"name": "Login - nonexistent user",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"nobody@example.com\",\n  \"password\": \"Passw0rd123\"\n}"
				},
				"url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
			}
		},
		{
			"name": "Protected route - no token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
			}
		},
		{
			"name": "Protected route - invalid token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer garbage.token.here" }],
				"url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
			}
		},
		{
			"name": "Protected route - valid token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
							"pm.test('Response contains the authenticated user', function () {",
							"    pm.expect(pm.response.json().user).to.have.property('email');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
				"url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
			}
		}
	],
	"variable": [
		{ "key": "base_url", "value": "https://localhost:3000" },
		{ "key": "jwt_token", "value": "" }
	]
}
